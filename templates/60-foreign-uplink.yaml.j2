# {{ ansible_managed }}
network:
  version: 2
  renderer: networkd
  ethernets:
    {{ foreign_interface }}:
      dhcp4: false
      addresses:
{% if foreign_ip is string %}
        - {{ foreign_ip }}/{{ foreign_subnet_mask }}
{% else %}
{% for ip in foreign_ip %}
        - {{ ip }}/{{ foreign_subnet_mask }}
{% endfor %}
{% endif %}
      routes:
        - to: 0.0.0.0/0
          via: {{ foreign_gateway }}
          table: 200
      routing-policy:
{% if foreign_ip is string %}
        - from: {{ foreign_ip }}
          table: 200
{% else %}
{% for ip in foreign_ip %}
        - from: {{ ip }}
          table: 200
{% endfor %}
{% endif %}
        - from: {{ vm_private_subnet }}
          table: 200
  bridges:
    vSwitch_DE:
      addresses:
        - {{ vm_private_gateway }}/24
      parameters:
        stp: false
        forward-delay: 0
